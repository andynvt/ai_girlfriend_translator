OPENAI_API_KEY=

# Demo presets: enable only one complete block (model + reasoning effort).
# Restart the local server after switching; update hosting env vars separately.
# Default: balance quality, speed, and cost.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal

# GPT-5: more capable than mini, with higher cost.
# OPENAI_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=minimal

# GPT-5 nano: fast and economical, for comparison.
# OPENAI_MODEL=gpt-5-nano
# OPENAI_REASONING_EFFORT=minimal

# GPT-5.6 Luna: newer, cost-sensitive model; minimal is not supported.
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=none

# GPT-6 Luna: newer Luna model; minimal is not supported.
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none

# Luna presets use none to keep reasoning latency low within the 400-token output budget.
# Higher reasoning effort may exhaust that budget before returning complete JSON.
# Model access depends on your OpenAI account; newer does not guarantee better results.
# Docs: https://developers.openai.com/api/docs/models/gpt-5.6-luna
# Docs: https://developers.openai.com/api/docs/models/gpt-6-luna

# TTS uses a separate model family; GPT-5/6 Luna cannot be used for speech generation.
# gpt-4o-mini-tts is the recommended speech model and supports style instructions.
# No GPT-5/6 TTS model is currently documented for the /v1/audio/speech endpoint.
# Docs: https://developers.openai.com/api/docs/guides/text-to-speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voice onboarding: recorded Vietnamese/English audio -> text.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Per-IP rate limit (10-minute window: translate 20, speak 30, onboarding 10).
# Create a free Upstash Redis database; leave empty to disable (requests are allowed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional public demo gate. Set the same strong secret locally and on hosting.
# With DEMO_ADMIN_TOKEN set, paid API endpoints default to CLOSED; Redis is required.
# The local Hub controls this HTTPS app origin; QR includes only the origin, never the token.
DEMO_APP_URL=
DEMO_ADMIN_TOKEN=
# Use a separate key/database for each deployment environment.
DEMO_ACCESS_KEY=thong-dich-tinh-yeu:demo:public
